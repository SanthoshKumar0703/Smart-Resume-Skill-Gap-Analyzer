# ============ Career Mirror AI — root .gitignore ============

# Python
__pycache__/
*.py[cod]
venv/
.venv/
*.egg-info/
.pytest_cache/

# Node
node_modules/
dist/
.vite/

# Environment files (never commit secrets)
.env
.env.local
